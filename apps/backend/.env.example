# Copy to .env to override. Every variable is optional, except CORS_ORIGINS in production;
# the defaults are shown.
# The schema is in src/config/env.schema.ts.
NODE_ENV=development
HOST=0.0.0.0
PORT=6000
# Comma-separated origins allowed by CORS. Required when NODE_ENV=production.
CORS_ORIGINS=
TRUST_PROXY=false
# Request body limit in bytes. Can only be lowered: the maximum is 1048576 (1 MB).
BODY_LIMIT_BYTES=1048576
# fatal, error, warn, info, debug, trace or silent. Defaults to debug in development, info otherwise.
LOG_LEVEL=debug
