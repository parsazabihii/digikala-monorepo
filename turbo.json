{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {},
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "BODY_LIMIT_BYTES",
        "LOG_LEVEL"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "CORS_ORIGINS",
        "TRUST_PROXY",
        "BODY_LIMIT_BYTES",
        "LOG_LEVEL"
      ]
    },
    "clean": {
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "//#format:check": {}
  }
}
